<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DeviceDefault löst sich auf Wear OS ins native Wear-Theme auf:
         volles rundes Fenster statt kleinem Phone-Window (v1.8: für die ganze App) -->
    <style name="Theme.TractiveWatch" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>

    <!-- Crash-Info nutzt dasselbe (Referenz bleibt aus Manifest-Gründen) -->
    <style name="Theme.TractiveWatch.Wear" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
</resources>
